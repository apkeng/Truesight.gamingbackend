# Server Configuration
PORT=5002
NODE_ENV=development
# NODE_ENV=production

# Supabase (Dashboard → Connect → Server)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional: Direct Postgres (Settings → Database)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# LLM (optional)
LLM_API_KEY=your-llm-api-key

# Email (optional)
GMAIL_EMAIL=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Production (uncomment when deploying)
# APP_URL=https://your-gaming-frontend.vercel.app
# FRONTEND_URL=https://your-gaming-frontend.vercel.app
